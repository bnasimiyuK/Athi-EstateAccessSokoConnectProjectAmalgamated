<h1><i class="fas fa-lock"></i> Set a new password</h1>
<p>Choose a strong password you have not used before.</p>
</div>
<form id="resetForm">
<div class="input-group">
<label for="password"><i class="fas fa-lock"></i> New password</label>
<input type="password" id="password" minlength="8" required placeholder="At least 8 characters" />
</div>
<div class="input-group">
<label for="password2"><i class="fas fa-lock"></i> Confirm password</label>
<input type="password" id="password2" minlength="8" required placeholder="Repeat new password" />
</div>
<div class="actions" style="margin-top:24px;">
<button type="submit" class="btn-primary" id="submitBtn" style="width:100%;">
<i class="fas fa-save"></i> Save new password
</button>
</div>
</form>
<div id="msgBox" class="backend-message hidden" style="margin-top:16px;">
<i class="fas fa-info-circle"></i>
<span id="msgText"></span>
</div>
<div class="login-link" style="margin-top:20px;">
<a href="login.html">&larr; Back to login</a>
</div>
</div>
</main>
</div>
<script src="js/auth.js?v=8"></script>
<script src="js/api.js?v=10"></script>
<script src="js/main.js?v=7"></script>
<script>
const params = new URLSearchParams(window.location.search);
const token  = params.get("token");
document.getElementById("resetForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  if (!token) return showMsg("Missing reset token. Use the link from your email.", true);
  const p1 = document.getElementById("password").value;
  const p2 = document.getElementById("password2").value;
  if (p1 !== p2) return showMsg("Passwords do not match.", true);
  if (p1.length < 8) return showMsg("Password must be at least 8 characters.", true);
  const btn = document.getElementById("submitBtn");
  btn.disabled = true;
  showMsg("Saving…", false);
  try {
    const res = await fetch(API_BASE + "/auth/reset-password", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token, password: p1 }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || "Reset failed");
    showMsg("Password updated. Redirecting to login…", false);
    setTimeout(() => { window.location.href = "login.html"; }, 1500);
  } catch (err) {
    showMsg(err.message || "Could not reset password.", true);
    btn.disabled = false;
  }
});
function showMsg(text, isError) {
  const box = document.getElementById("msgBox");
  const txt = document.getElementById("msgText");
  box.classList.remove("hidden");
  box.classList.toggle("error", !!isError);
  txt.textContent = text;
}
</script>
