  <div class="side-rail__footer">
    <div class="side-rail__status">
      <span class="side-rail__dot"></span>
      Estate server connected
    </div>
  </div>
</aside>

<!-- Mobile toggle -->
<button class="side-rail__toggle" id="side-rail-toggle" aria-label="Toggle navigation" type="button">
  <i class="fas fa-bars"></i>
</button>
<div class="side-rail__backdrop" id="side-rail-backdrop"></div>


<div class="side-rail__content">
  <div class="side-rail__topbar">
    <div class="side-rail__topbar-inner">
      <div class="side-rail__topbar-left" id="topbar-left"></div>
      <div class="side-rail__topbar-user" id="topbar-user"></div>
    </div>
  </div>

  <main class="container dx-main">
  <div class="page-head page-head--with-actions">
    <div class="page-head__text">
      <h1>Visitors — Admin approval</h1>
      <p>Stage 1 of the two-stage approval. Once approved here, security makes the final decision.</p>
    </div>
    <div class="admin-actions">
      <a href="admin-visitor-analytics.html" class="btn btn--ghost">📊 Analytics</a>
      <a href="security-visitors.html" class="btn btn--ghost">🛡️ Security view</a>
    </div>
  </div>

  <section class="stat-section">
    <div class="stat-tiles">
      <div class="stat-tile stat-tile--warn">
        <div class="stat-tile__value" id="tile-pending">—</div>
        <div class="stat-tile__label">Pending admin approval</div>
      </div>
      <div class="stat-tile stat-tile--info">
        <div class="stat-tile__value" id="tile-pending-sec">—</div>
        <div class="stat-tile__label">Waiting for security</div>
      </div>
      <div class="stat-tile stat-tile--ok">
        <div class="stat-tile__value" id="tile-approved">—</div>
        <div class="stat-tile__label">Approved (30d)</div>
      </div>
      <div class="stat-tile stat-tile--danger">
        <div class="stat-tile__value" id="tile-denied">—</div>
        <div class="stat-tile__label">Denied (30d)</div>
      </div>
    </div>
  </section>

  <div class="tab-row">
    <button class="tab-btn is-active" data-tab="pending">
      Pending approval <span id="count-pending"></span>
    </button>
    <button class="tab-btn" data-tab="all">
      All visits
    </button>
  </div>

  <!-- Tab: Pending admin approval -->
  <div class="tab-panel is-active" id="tab-pending">

    <!-- Bulk action bar -->
    <div id="bulk-bar"
         style="display:none;background:#16233f;color:#fff;padding:12px 18px;border-radius:8px;margin-bottom:16px;align-items:center;gap:14px;flex-wrap:wrap;">
      <span style="font-weight:600;"><span id="bulk-count">0</span> selected</span>
      <button class="btn btn--accent btn--small" id="bulk-approve-btn">✓ Approve selected</button>
      <button class="btn btn--danger btn--small" id="bulk-deny-btn">✕ Deny selected</button>
      <button class="btn btn--ghost btn--small" id="bulk-clear-btn" style="color:#fff;border-color:#fff;">Clear</button>
      <span style="margin-left:auto;font-size:0.85rem;color:#dcd8cd;">
        Max 200 per click
      </span>
    </div>

    <div style="display:flex;justify-content:flex-end;margin-bottom:14px;">
      <button class="btn btn--danger btn--small" id="btn-approve-all" type="button" style="display:none;">
        ⚠️ Approve ALL pending
      </button>
    </div>

    <div id="pending-list">
      <div class="empty-state">Loading…</div>
    </div>
    <div id="pending-pagination"></div>
  </div>

  <!-- Tab: All visits -->
  <div class="tab-panel" id="tab-all">
    <form id="all-filter" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;">
      <select id="filter-status" class="input">
        <option value="">All statuses</option>
        <option value="pending_admin">Pending admin</option>
        <option value="pending_security">Pending security</option>
        <option value="approved">Approved</option>
        <option value="checked_in">Checked in</option>
        <option value="completed">Completed</option>
        <option value="denied">Denied</option>
        <option value="cancelled">Cancelled</option>
        <option value="expired">Expired</option>
      </select>
      <input type="text" id="filter-q" class="input" placeholder="Search house, code, name…" style="min-width:240px;" />
      <button type="submit" class="btn btn--accent">Filter</button>
      <button type="button" id="filter-clear" class="btn btn--ghost">Clear</button>
    </form>
    <div id="all-list">
      <div class="empty-state">Loading…</div>
    </div>
    <div id="all-pagination"></div>
  </div>
</main>
</div>

<!-- Typed confirmation modal -->
<div id="confirm-all-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:300;align-items:center;justify-content:center;">
  <div style="background:#fff;max-width:480px;width:90%;padding:24px;border-radius:8px;">
    <h2 style="margin-top:0;color:#b0472e;">⚠️ Approve all pending?</h2>
    <p id="confirm-all-text" style="color:var(--ink-70);">
      This will approve every pre-registration in the pending admin list.
    </p>
    <p style="color:var(--ink-70);font-size:0.9rem;">
      To confirm, type <b>APPROVE ALL</b> in the box below:
    </p>
    <input type="text" id="confirm-all-input" class="input" placeholder="APPROVE ALL" style="width:100%;font-family:monospace;" autocomplete="off" />
    <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px;">
      <button type="button" class="btn btn--ghost" id="confirm-all-cancel">Cancel</button>
      <button type="button" class="btn btn--danger" id="confirm-all-go" disabled>Approve all</button>
    </div>
  </div>
</div>

<footer class="site-footer">
  <div class="container" style="width:100%;">
    Both admin and security must approve before an access code is issued.
  </div>
</footer>

<script src="js/auth.js?v=8"></script>
<script src="js/api.js?v=3"></script>
<script src="js/main.js?v=7"></script>
<script src="js/admin-visitors.js?v=3"></script>
</body>
</html>
