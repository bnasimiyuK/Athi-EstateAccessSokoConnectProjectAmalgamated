      <circle cx="22" cy="26" r="2.6" fill="#fff"/>
    </svg>
    <span class="side-rail__brand-text">
      <b>Athi Soko Connect</b>
      <small>Athi Highway Estate</small>
    </span>
  </a>

  <nav class="side-rail__nav" aria-label="Main">
    <a href="index.html" data-nav="index.html">
      <i class="fas fa-compass" aria-hidden="true"></i>
      <span>Discover</span>
    </a>

    <a href="register.html" data-nav="register.html" data-roles="resident,admin,super-admin" hidden>
      <i class="fas fa-user-plus" aria-hidden="true"></i>
      <span>Become a Provider</span>
    </a>

    <a href="dashboard.html" data-nav="dashboard.html" data-roles="resident,vendor,admin,super-admin" hidden>
      <i class="fas fa-calendar-check" aria-hidden="true"></i>
      <span>My Bookings</span>
    </a>

    <a href="visitors.html" data-nav="visitors.html" data-roles="resident,admin,super-admin" hidden>
      <i class="fas fa-user-friends" aria-hidden="true"></i>
