      <div class="side-rail__topbar-left" id="topbar-left"></div>
      <div class="side-rail__topbar-user" id="topbar-user"></div>
    </div>
  </div>

  <main class="container dx-main">
  <div class="page-head">
    <h1>My bookings</h1>
    <p>Track every request from sent to done. This demo simulates provider responses — use the buttons below to move a booking along.</p>
  </div>

  <div id="booking-list" class="section" style="padding-top:0;"></div>
</main>
</div>

<div class="modal-backdrop" id="review-modal">
  <div class="modal">
    <h3>Rate this booking</h3>
    <p id="review-target"></p>
    <form id="review-form">
      <div class="field" style="margin-bottom:12px;">
        <label for="review-rating">Rating</label>
        <select id="review-rating">
          <option value="5">★★★★★ Excellent</option>
          <option value="4">★★★★☆ Good</option>
          <option value="3">★★★☆☆ Okay</option>
          <option value="2">★★☆☆☆ Poor</option>
          <option value="1">★☆☆☆☆ Very poor</option>
        </select>
      </div>
      <div class="field" style="margin-bottom:12px;">
        <label for="review-text">Comment</label>
        <textarea id="review-text" rows="3" required placeholder="What was the experience like?"></textarea>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn--ghost" id="review-cancel">Cancel</button>
        <button type="submit" class="btn btn--accent">Submit review</button>
      </div>
    </form>
  </div>
</div>

<footer class="site-footer">
  <div class="container" style="width:100%;">Bookings and statuses shown here are stored on this device only, for demo purposes.</div>
</footer>
