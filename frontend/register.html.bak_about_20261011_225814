  <main class="container dx-main">
    <div class="page-head">
      <h1>List your service to the whole estate</h1>
      <p>One profile, always visible. Only <strong>registered residents</strong> can become vendors. An estate admin reviews new listings before they go live.</p>
    </div>

    <!-- Progress -->
    <ol class="reg-steps" id="reg-steps" aria-label="Progress">
      <li class="is-current" data-step="1"><span class="reg-steps_dot">1</span> Verify residency</li>
      <li class="reg-steps_bar" aria-hidden="true"></li>
      <li data-step="2"><span class="reg-steps_dot">2</span> Your listing</li>
      <li class="reg-steps_bar" aria-hidden="true"></li>
      <li data-step="3"><span class="reg-steps_dot">3</span> Admin review</li>
    </ol>

    <div class="reg-layout" id="reg-layout">
      <div class="reg-main">

        <!-- STEP 1: Verify resident by phone -->
        <form class="form-card form-card--narrow" id="resident-check-form" novalidate>
          <h2>Step 1 - Verify you're a resident</h2>
          <p class="form-card_lead">Enter the phone number you used when signing up.</p>
          <div class="form-grid">
            <div class="field field--full">
              <label for="r-phone">Phone number</label>
              <input type="tel" id="r-phone" placeholder="07XX XXX XXX" autocomplete="tel" inputmode="tel" required />
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn--primary" id="verify-btn">Verify residency</button>
            <a href="/residents.html" class="form-actions_link">Not a resident yet? Sign up</a>
          </div>
          <div id="check-message" class="msg" role="status" hidden></div>
        </form>

        <!-- STEP 2: Vendor application (hidden until verified) -->
        <form class="form-card form-card--wide" id="register-form" novalidate hidden>
          <h2>Step 2 - Your vendor listing</h2>

          <!-- Resident info (read-only) -->
          <div class="notice notice--spaced" id="resident-info"></div>

          <div class="form-grid">
            <div class="field field--full">
              <label for="r-name">Business / display name</label>
              <input type="text" id="r-name" required autocomplete="off" placeholder="e.g. Grace's Cleaning Services" />
            </div>

            <div class="field">
              <label for="r-category">Category</label>
              <select id="r-category" required></select>
            </div>
            <div class="field">
              <label for="r-hours">Working hours</label>
              <input type="text" id="r-hours" autocomplete="off" placeholder="e.g. Mon-Sat, 8am-5pm" required />
            </div>

            <div class="field">
              <label for="r-price">Starting price (KSh)</label>
              <input type="number" id="r-price" min="0" inputmode="numeric" placeholder="e.g. 1500" required />
            </div>
            <div class="field">
              <label for="r-price-unit">Price unit</label>
              <select id="r-price-unit">
                <option>per visit</option>
                <option>per hour</option>
                <option>per day</option>
                <option>per session</option>
                <option>per trip</option>
              </select>
            </div>

            <div class="field field--full">
              <label for="r-bio">Short description</label>
              <textarea id="r-bio" rows="3" required placeholder="What you do and your experience in the estate"></textarea>
            </div>

            <div class="field field--full">
              <label for="r-services">Services offered (comma-separated)</label>
              <input type="text" id="r-services" autocomplete="off" placeholder="e.g. Leak repair, Drain unblocking" required />
              <span class="field_hint">Each service becomes a tag on your listing.</span>
            </div>

            <fieldset class="field--full">
              <legend>Before you submit</legend>
              <label class="check-row"><input type="checkbox" id="r-accurate" required /> The details above are accurate to the best of my knowledge.</label>
              <label class="check-row"><input type="checkbox" id="r-terms" required /> I understand payment is arranged directly with residents - the platform does not process payments.</label>
            </fieldset>
          </div>

          <div id="submit-message" class="msg msg--error" role="alert" hidden></div>

          <div class="form-actions form-actions--spaced">
            <button type="submit" class="btn btn--accent" id="submit-btn">Submit for verification</button>
            <button type="button" class="btn btn--ghost" id="back-btn">Use a different number</button>
            <span class="form-actions_note">Usually reviewed within 2 business days.</span>
          </div>
        </form>

        <!-- CONFIRMATION -->
        <section class="form-card form-card--wide" id="done-card" aria-live="polite" hidden>
          <h2 id="done-title">Application sent</h2>
          <p class="form-card_lead">Your listing is now with the estate admin. You will get a notification when it goes live.</p>
          <ul class="timeline">
            <li class="is-done"><span class="timeline_pt"></span><div><b>Residency verified</b><span id="done-resident"></span></div></li>
            <li class="is-done"><span class="timeline_pt"></span><div><b>Listing submitted</b><span id="done-time"></span></div></li>
            <li class="is-current"><span class="timeline_pt"></span><div><b>Admin review</b><span>Usually within 2 business days.</span></div></li>
            <li><span class="timeline_pt"></span><div><b>Live on Discover</b><span>Residents can find and book you.</span></div></li>
          </ul>
          <div class="form-actions form-actions--spaced">
            <button type="button" class="btn btn--primary" id="again-btn">Register another listing</button>
          </div>
        </section>
      </div>

      <!-- Live listing preview (visible during Step 2) -->
      <aside class="listing-preview" id="listing-preview" aria-label="Listing preview" hidden>
        <h3 class="listing-preview_title">How residents will see it</h3>
        <div class="listing-card">
          <span class="listing-card_cat" id="p-cat">Category</span>
          <h3 class="listing-card_name" id="p-name"></h3>
          <span class="listing-card_loc" id="p-loc"></span>
          <p class="listing-card_bio" id="p-bio"></p>
          <div class="listing-card_tags" id="p-tags"></div>
          <div class="listing-card_meta">
            <span id="p-hours"></span>
            <span class="listing-card_price" id="p-price"></span>
          </div>
          <span class="listing-card_status">Pending admin verification</span>
        </div>
      </aside>
    </div>
