<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AHEWA Events</title>
  <link rel="stylesheet" href="css/styles.css" />
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
</head>
<body class="discover-body has-sidebar">

<!-- ============================================================
     SIDEBAR
     ============================================================ -->
<aside class="side-rail" id="side-rail" aria-label="Main navigation">
  <a href="index.html" class="side-rail__brand" aria-label="Athi Soko Connect - home">
    <svg class="side-rail__mark" viewBox="0 0 44 44" aria-hidden="true">
      <rect width="44" height="44" rx="12" fill="#16233f"/>
      <path d="M12 30 22 13l10 17z" fill="none" stroke="#c8862a" stroke-width="2.6" stroke-linejoin="round"/>
      <circle cx="22" cy="26" r="2.6" fill="#fff"/>
    </svg>
    <span class="side-rail__brand-text">
      <b>Athi Soko Connect</b>
      <small>Athi Highway Estate</small>
    </span>
  </a>

  <nav class="side-rail__nav" aria-label="Main">
    <a href="index.html" data-nav="index.html">
      <i class="fas fa-compass" aria-hidden="true"></i>
      <span>Discover</span>
    </a>

    <a href="register.html" data-nav="register.html" data-roles="resident,admin,super-admin" hidden>
      <i class="fas fa-user-plus" aria-hidden="true"></i>
      <span>Become a Provider</span>
    </a>

    <a href="dashboard.html" data-nav="dashboard.html" data-roles="resident,vendor,admin,super-admin" hidden>
      <i class="fas fa-calendar-check" aria-hidden="true"></i>
      <span>My Bookings</span>
    </a>

    <a href="provider-profile.html" data-nav="provider-profile.html" data-roles="vendor,provider,admin,super-admin" hidden>
      <i class="fas fa-store" aria-hidden="true"></i>
      <span>My Profile</span>
    </a>

    <a href="visitors.html" data-nav="visitors.html" data-roles="resident,admin,super-admin" hidden>
      <i class="fas fa-user-friends" aria-hidden="true"></i>
      <span>My Visitors</span>
    </a>

    <a href="billing.html" data-nav="billing.html" data-roles="resident,admin,super-admin" hidden>
      <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>
      <span>My Billing &amp; Payments</span>
    </a>

    <a href="notices.html" data-nav="notices.html">
      <i class="fas fa-bullhorn" aria-hidden="true"></i>
      <span>Estate Notice Board</span>
    </a>

    <a href="security-visitors.html" data-nav="security-visitors.html" data-roles="security,admin,super-admin" hidden>
      <i class="fas fa-shield-halved" aria-hidden="true"></i>
      <span>Security &mdash; Visitors</span>
    </a>

    <a href="admin.html" data-nav="admin.html" data-roles="admin,super-admin" hidden>
      <i class="fas fa-user-shield" aria-hidden="true"></i>
      <span>Admin</span>
    </a>

    <a href="super-admin.html" data-nav="super-admin.html" data-roles="super-admin" hidden>
      <i class="fas fa-crown" aria-hidden="true"></i>
      <span>Super Admin</span>
    </a>
  </nav>

  <div class="side-rail__footer">
    <div class="side-rail__status">
      <span class="side-rail__dot"></span>
      Estate server connected
    </div>
  </div>
</aside>

<!-- Mobile toggle -->
<button class="side-rail__toggle" id="side-rail-toggle" aria-label="Toggle navigation" type="button">
  <i class="fas fa-bars"></i>
</button>
<div class="side-rail__backdrop" id="side-rail-backdrop"></div>


<div class="side-rail__content">
  <div class="side-rail__topbar">
    <div class="side-rail__topbar-inner">
      <div class="side-rail__topbar-left" id="topbar-left"></div>
      <div class="side-rail__topbar-user" id="topbar-user"></div>
    </div>
  </div>

  <main class="container dx-main">
  <div style="margin-bottom: 16px;">
    <a href="ahewa.html" class="btn btn--ghost btn--small">← Back to AHEWA Dashboard</a>
  </div>

  <div id="event-header"></div>

  <!-- ============================================================
       Contribution matrix
       ============================================================ -->
  <section class="stat-section" style="margin-top: 32px;">
    <h3 class="stat-section__title">Contribution status</h3>
    <div class="stat-tiles" id="contrib-stats"></div>
    <div class="table-wrap" id="contrib-table">
      <div class="empty-state">Loading contributions…</div>
    </div>
  </section>

  <!-- ============================================================
       Signatory approvals
       ============================================================ -->
  <section class="stat-section">
    <h3 class="stat-section__title">Disbursement co-authorization</h3>
    <div id="approvals-panel">
      <div class="empty-state">Loading approvals…</div>
    </div>
  </section>
  <!-- ============================================================
       Event photo gallery
       ============================================================ -->
  <section class="stat-section" id="gallery-section">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
      <h3 class="stat-section__title" style="margin:0; border:none; padding:0;">Event photo gallery</h3>
      <button id="btn-upload-photo" class="btn btn--accent btn--small" style="display:none;">
        📷 Add photo
      </button>
    </div>

    <div id="gallery-grid" class="ahewa-gallery">
      <div class="empty-state">Loading photos…</div>
    </div>
  </section>

  <!-- ============================================================
       Upload photo modal
       ============================================================ -->
  <div class="modal-backdrop" id="modal-upload-photo">
    <div class="modal" style="max-width: 480px;">
      <h2 style="margin-top:0;">Add a photo</h2>
      <p style="color:var(--ink-70); margin-top:-8px; font-size:0.9rem;">
        JPG, PNG, WEBP, or HEIC. Max 5 MB.
      </p>

      <form id="form-upload-photo" style="display:flex; flex-direction:column; gap:14px; margin-top:16px;">
        <label class="field">
          <span>Photo</span>
          <input type="file" id="photo-file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" required />
        </label>

        <label class="field">
          <span>Caption <small style="color:var(--ink-70);">(optional)</small></span>
          <input type="text" id="photo-caption" class="input" maxlength="500" placeholder="e.g. Memorial service, 2 Oct 2026" />
        </label>

        <div id="photo-upload-status" class="notice" style="display:none;"></div>

        <div class="modal-actions">
          <button type="button" class="btn btn--ghost" id="btn-cancel-photo">Cancel</button>
          <button type="submit" class="btn btn--accent" id="btn-submit-photo">Upload</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================
       Lightbox
       ============================================================ -->
  <div class="modal-backdrop" id="modal-lightbox" style="background: rgba(0,0,0,0.85);">
    <div style="position:relative; max-width:90vw; max-height:90vh;">
      <img id="lightbox-img" src="" alt="" style="max-width:90vw; max-height:80vh; border-radius:8px; display:block;" />
      <p id="lightbox-caption" style="color:white; text-align:center; margin-top:12px; font-size:0.95rem;"></p>
      <button id="btn-lightbox-close" 
              style="position:absolute; top:-40px; right:0; background:white; border:none; 
                     border-radius:50%; width:36px; height:36px; cursor:pointer; font-size:1.2rem;">×</button>
    </div>
  </div>
  <!-- ============================================================
       Action buttons
       ============================================================ -->
  <section class="stat-section" id="exports-section">
    <h3 class="stat-section__title">Exports</h3>
    <div class="admin-actions" style="padding-top:0;">
      <button id="btn-export-xlsx" class="btn btn-export" type="button">📥 Excel</button>
      <button id="btn-export-pdf"  class="btn btn-export" type="button">📄 PDF</button>
    </div>
  </section>
</main>
</div>

<footer class="site-footer">
  <div class="container" style="width:100%;">
    Disbursement requires all three signatory approvals. Payment is collected via Paybill to the estate account.
  </div>
</footer>

<script src="js/auth.js?v=8"></script>
<script src="js/api.js?v=10"></script>
<script src="js/main.js?v=7"></script>
<script src="js/ahewa-event.js"></script>
</body>
</html>
